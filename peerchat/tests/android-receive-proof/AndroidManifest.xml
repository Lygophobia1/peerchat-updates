<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="com.peerchat.voiceproof">
    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="35" />
    <!-- Isolated algorithm proof: no microphone, network, storage or account permissions. -->
    <application android:label="PeerChat Receive Proof" android:debuggable="true" android:extractNativeLibs="true">
        <activity android:name=".ProofActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
