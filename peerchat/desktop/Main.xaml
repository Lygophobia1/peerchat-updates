<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:PeerChatDesktop;assembly=PeerChat.Desktop"
 Title="PeerChat" Width="1440" Height="940" MinWidth="1120" MinHeight="740" Background="#0C1116" Foreground="#EDF1F5" FontFamily="Segoe UI" FontSize="15" WindowStartupLocation="CenterScreen">
 <Window.Resources>
  <SolidColorBrush x:Key="Muted" Color="#A1AEBB"/>
  <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style TargetType="ScrollBar"><Setter Property="Width" Value="8"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Grid Background="#101820"><Track x:Name="PART_Track" IsDirectionReversed="True"><Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0"/></Track.DecreaseRepeatButton><Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="#344452" CornerRadius="4" Margin="1"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0"/></Track.IncreaseRepeatButton></Track></Grid></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="Button">
   <Setter Property="Foreground" Value="#EDF1F5"/><Setter Property="Background" Value="#19222B"/><Setter Property="BorderBrush" Value="#303D49"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="16,12"/><Setter Property="Cursor" Value="Hand"/><Setter Property="HorizontalContentAlignment" Value="Left"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" CornerRadius="9" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"><ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#2A3744"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Background" Value="#34485C"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#62B9ED"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="TextBox"><Setter Property="Foreground" Value="#EDF1F5"/><Setter Property="CaretBrush" Value="White"/><Setter Property="Background" Value="#151D25"/><Setter Property="BorderBrush" Value="#344351"/><Setter Property="Padding" Value="12,10"/><Setter Property="SelectionBrush" Value="#326EAD"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8"><ScrollViewer x:Name="PART_ContentHost" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}" Margin="{TemplateBinding Padding}"/></Border><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="#62B9ED"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="PasswordBox"><Setter Property="Foreground" Value="#EDF1F5"/><Setter Property="CaretBrush" Value="White"/><Setter Property="Background" Value="#151D25"/><Setter Property="BorderBrush" Value="#344351"/><Setter Property="Padding" Value="12,10"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="PasswordBox"><Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8"><ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/></Border><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="#62B9ED"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="#111920"/><Setter Property="BorderBrush" Value="#25313C"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="13"/><Setter Property="Padding" Value="16"/><Setter Property="Margin" Value="0,0,0,14"/></Style>
  <Style x:Key="CardTitle" TargetType="TextBlock"><Setter Property="FontSize" Value="18"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,0,15"/></Style>
  <Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,2"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Row" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="9"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="#18222C"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="#192F44"/><Setter TargetName="Row" Property="BorderBrush" Value="#326087"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 </Window.Resources>
 <Grid Background="#0C1116" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">
  <Grid.ColumnDefinitions><ColumnDefinition Width="290"/><ColumnDefinition Width="*" MinWidth="480"/><ColumnDefinition Width="292"/></Grid.ColumnDefinitions>
  <Border Grid.Column="0" Background="#0E151B" BorderBrush="#25303A" BorderThickness="0,0,1,0">
   <Grid Margin="16,20,16,12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Margin="4,0,0,24"><Grid.ColumnDefinitions><ColumnDefinition Width="65"/><ColumnDefinition/></Grid.ColumnDefinitions><Border Background="#294E8A" CornerRadius="18" Width="56" Height="60" HorizontalAlignment="Left"><TextBlock Text="p" FontSize="44" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,-7,0,0"/></Border><StackPanel Grid.Column="1"><TextBlock Text="PeerChat" FontSize="27" FontWeight="SemiBold"/><TextBlock Text="Your People. Your Space." FontSize="12" Foreground="{StaticResource Muted}" Margin="0,4,0,0"/></StackPanel></Grid>
    <StackPanel Grid.Row="1"><Button x:Name="Profile" Content="○    My Profile" Margin="0,0,0,14" Padding="10,10"/><Button x:Name="AddFriend" Content="＋    Add Friend" Visibility="Collapsed"/><Button x:Name="FindFriend" Content="⌕    Find Friends" Margin="0,0,0,8"/><Button x:Name="FriendRequests" Content="♙    Friend Requests" Margin="0,0,0,8"/><Button x:Name="CopyId" Content="▣    Copy My ID" Visibility="Collapsed"/><Button x:Name="AccountRegister" Content="☻    Create Account" Margin="0,0,0,8"/><Button x:Name="AccountLogin" Content="↪    Sign In" Margin="0,0,0,8"/><Button x:Name="AccountSignOut" Content="⇥    Sign Out" Visibility="Collapsed"/></StackPanel>
    <TextBlock Grid.Row="2" Text="CONVERSATIONS" Foreground="{StaticResource Muted}" FontSize="13" Margin="0,0,0,10"/>
    <Border Grid.Row="3" BorderBrush="#28343F" BorderThickness="0,0,0,1" Padding="0" Margin="0,0,0,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions><Button x:Name="DM" Content="Messages" FontSize="13" Padding="8,9" HorizontalContentAlignment="Center" Background="Transparent" BorderThickness="0,0,0,2"/><Button x:Name="Groups" Grid.Column="1" Content="Groups" FontSize="13" Padding="8,9" HorizontalContentAlignment="Center" Background="Transparent" BorderThickness="0,0,0,2"/></Grid></Border>
    <Grid Grid.Row="4" Margin="0,0,0,8"><TextBox x:Name="Search" Height="43" ToolTip="Search conversations by name"/><TextBlock x:Name="SearchHint" Text="⌕   Search conversations…" IsHitTestVisible="False" Foreground="{StaticResource Muted}" Margin="13,11" FontSize="13"/></Grid>
    <Grid Grid.Row="5"><ListBox x:Name="ContactList" Foreground="#EDF1F5" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"><ListBox.ItemTemplate><DataTemplate><Grid Margin="10,12"><Grid.ColumnDefinitions><ColumnDefinition Width="47"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid Width="36" Height="36" VerticalAlignment="Top"><Ellipse Fill="#416181"/><TextBlock Text="{Binding Initial}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="19"/><Ellipse Width="9" Height="9" Fill="{Binding Presence}" VerticalAlignment="Bottom" HorizontalAlignment="Right"/></Grid><StackPanel Grid.Column="1"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="{Binding When}" FontSize="10" Foreground="{StaticResource Muted}" Margin="5,3,0,0"/></Grid><TextBlock Text="{Binding Preview}" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,5,0,0"/><TextBlock Text="{Binding UnreadLabel}" Foreground="#61B6EB" FontSize="11"/></StackPanel></Grid></DataTemplate></ListBox.ItemTemplate></ListBox><StackPanel x:Name="ListEmptyPanel"><TextBlock x:Name="ListEmpty" Text="Find friends to start building your friend list." Foreground="{StaticResource Muted}" Margin="12,24,12,8"/><TextBlock x:Name="FriendAreaStatus" Visibility="Collapsed" Text="Friends · 0   Incoming · 0   Pending · 0" Foreground="{StaticResource Muted}" FontSize="11" Margin="12,0" TextWrapping="Wrap"/></StackPanel></Grid>
    <StackPanel Grid.Row="6"><Border Height="1" Background="#28333D" Margin="0,10"/><Button x:Name="Manual" Content="♧    Manual Connect" Visibility="Collapsed" Background="Transparent" BorderThickness="0"/><Button x:Name="Settings" Content="⚙    Settings" Background="Transparent" BorderThickness="0"/><TextBlock x:Name="LocalProfile" Foreground="{StaticResource Muted}" FontSize="12" Margin="16,6,0,0"/></StackPanel>
   </Grid>
  </Border>
  <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="112"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Border BorderBrush="#28343F" BorderThickness="0,0,0,1" Padding="22,18"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Background="#28539A" CornerRadius="32" Width="60" Height="60" HorizontalAlignment="Left"><TextBlock x:Name="HeaderInitial" Text="p" FontSize="29" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock x:Name="HeaderName" Text="Your conversations" FontSize="24" FontWeight="SemiBold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="HeaderStatus" Text="Choose a friend to start chatting" Foreground="{StaticResource Muted}" FontSize="13" Margin="0,5,0,0"/></StackPanel><StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="VoiceCall" Content="Call" Padding="14,9" ToolTip="Start a secure voice call"/><Button x:Name="PeerInfo" Content="ⓘ" FontSize="22" Padding="13,7" Margin="8,0,0,0" ToolTip="Selected peer details"/></StackPanel></Grid></Border>
   <Grid Grid.Row="1"><ScrollViewer x:Name="MessageScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="24,20"><StackPanel><Button x:Name="Older" Content="↑    Load older messages" HorizontalAlignment="Center" Padding="22,9" Margin="0,0,0,16"/><ItemsControl x:Name="Messages"><ItemsControl.ItemTemplate><DataTemplate><Border Background="{Binding Bubble}" HorizontalAlignment="{Binding Alignment}" MaxWidth="{Binding BubbleWidth}" CornerRadius="15" Padding="16,12" Margin="0,0,0,12"><StackPanel><local:ChatText Message="{Binding Text}" FontSize="16" TextWrapping="Wrap"/><TextBlock Text="{Binding Stamp}" HorizontalAlignment="Right" Foreground="#B7C7D9" FontSize="11" Margin="0,8,0,0"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></ScrollViewer><StackPanel x:Name="ChatEmpty" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="340" Margin="30"><TextBlock x:Name="EmptyTitle" Text="Good conversations start here." FontSize="23" FontWeight="SemiBold" TextAlignment="Center"/><TextBlock x:Name="EmptyDescription" Text="Share your PeerChat ID with a friend, or paste theirs to connect directly." Foreground="{StaticResource Muted}" TextAlignment="Center" Margin="0,14,0,18"/><Button x:Name="EmptyAction" Content="＋    Add Friend" HorizontalAlignment="Center"/></StackPanel></Grid>
   <Border Grid.Row="2" BorderBrush="#25303A" BorderThickness="0,1,0,0" Padding="20,16,20,12"><StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="58"/><ColumnDefinition Width="*"/><ColumnDefinition Width="62"/></Grid.ColumnDefinitions><Button x:Name="Attachment" Content="♧" IsEnabled="False" ToolTip="Attachments are not available yet" Padding="10" FontSize="24" Margin="0,0,8,0"/><Grid Grid.Column="1"><TextBox x:Name="Composer" MinHeight="62" MaxHeight="150" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="14,16" MaxLength="16384"/><TextBlock x:Name="ComposerHint" Text="Type a message…" Foreground="{StaticResource Muted}" Margin="15,19" IsHitTestVisible="False"/></Grid><Button Grid.Column="2" x:Name="Send" Content="➤" Background="#275AA7" FontSize="24" HorizontalContentAlignment="Center" Padding="10" Margin="9,0,0,0"/></Grid><TextBlock Text="Enter to send  ·  Shift+Enter for a new line" Foreground="{StaticResource Muted}" FontSize="11" Margin="48,10,0,0"/></StackPanel></Border>
  </Grid>
  <Border Grid.Column="2" Background="#0D141A" BorderBrush="#25303A" BorderThickness="1,0,0,0"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="14,16">
   <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Connection" Style="{StaticResource CardTitle}"/><TextBlock x:Name="Listener" Text="Opening your profile…" Foreground="{StaticResource Muted}"/><TextBlock x:Name="PeerCount" Text="0 peers connected" Foreground="{StaticResource Muted}" Margin="0,10,0,0"/><TextBlock x:Name="CompactConnectionStatus" Text="Offline" FontWeight="SemiBold" Margin="0,12,0,0"/><TextBlock x:Name="LastConnectionFailure" Text="Last failure: none" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,5,0,12"/><Button x:Name="Reconnect" Content="⟳    Try Reconnect" HorizontalContentAlignment="Center" Margin="0,0,0,7"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Button x:Name="CopyConnectionDetails" Content="Copy Details" HorizontalContentAlignment="Center" Padding="8" Margin="0,0,4,0"/><Button x:Name="ViewConnectionLog" Grid.Column="1" Content="View Log" HorizontalContentAlignment="Center" Padding="8" Margin="4,0,0,0"/></Grid><Button x:Name="Details" Content="⌁    Show Details" HorizontalContentAlignment="Center" Margin="0,7,0,0"/></StackPanel></Border>
   <Border x:Name="VoiceCard" Visibility="Collapsed" Style="{StaticResource Card}"><StackPanel><TextBlock Text="Voice Call" Style="{StaticResource CardTitle}"/><TextBlock x:Name="VoiceFriend" Text="Friend" FontWeight="SemiBold"/><TextBlock x:Name="VoiceState" Text="Idle" Foreground="{StaticResource Muted}" Margin="0,5,0,0"/><TextBlock x:Name="VoiceDuration" Text="00:00" FontSize="22" Margin="0,10,0,12"/><TextBlock Text="Microphone" Foreground="{StaticResource Muted}"/><ComboBox x:Name="VoiceInput" Margin="0,3,0,7"/><TextBlock Text="Output" Foreground="{StaticResource Muted}"/><ComboBox x:Name="VoiceOutput" Margin="0,3,0,9"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Button x:Name="VoiceMute" Content="Mute" IsEnabled="False" HorizontalContentAlignment="Center" Margin="0,0,4,7"/><Button x:Name="VoiceDeafen" Grid.Column="1" Content="Deafen" IsEnabled="False" HorizontalContentAlignment="Center" Margin="4,0,0,7"/></Grid><Button x:Name="VoiceHangUp" Content="Hang Up" Background="#7A2631" HorizontalContentAlignment="Center"/></StackPanel></Border>
   <Border x:Name="PeerIdentityCard" Visibility="Collapsed" Style="{StaticResource Card}"><StackPanel><TextBlock Text="My Peer ID" Style="{StaticResource CardTitle}"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="43"/></Grid.ColumnDefinitions><Border Background="#0C1116" BorderBrush="#344351" BorderThickness="1" CornerRadius="8" Padding="10" Height="42"><TextBlock x:Name="OwnId" FontSize="12" Text="Waiting for identity" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/></Border><Button Grid.Column="1" x:Name="CopyCompact" Content="▣" Padding="11" ToolTip="Copy shareable PeerChat ID"/></Grid><TextBlock x:Name="EndpointHint" Text="Shareable endpoint: detecting…" Foreground="{StaticResource Muted}" Margin="0,11,0,0" FontSize="12" TextWrapping="Wrap"/><TextBlock x:Name="LanEndpoint" Text="LAN: detecting…" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,7,0,0"/><TextBlock x:Name="PublicEndpoint" Text="Public: Detecting…" Foreground="{StaticResource Muted}" FontSize="12"/></StackPanel></Border>
   <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Security" Style="{StaticResource CardTitle}"/><TextBlock x:Name="Status" Text="Starting…" Margin="0,0,0,15" FontSize="14"/><TextBlock x:Name="Security" Text="TLS: no active peer connection" Foreground="{StaticResource Muted}" FontSize="13"/><TextBlock x:Name="StorageStatus" Text="Local profile: opening" Foreground="{StaticResource Muted}" FontSize="13" Margin="0,9,0,0"/><TextBlock x:Name="VersionText" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,9,0,0"/></StackPanel></Border>
   <Border x:Name="QuickActionsCard" Visibility="Collapsed" Style="{StaticResource Card}"><StackPanel><TextBlock Text="Quick Actions" Style="{StaticResource CardTitle}"/><Button x:Name="QuickAdd" Content="＋    Add Friend" Margin="0,0,0,7"/><Button x:Name="QuickCopy" Content="▣    Copy My ID" Margin="0,0,0,7"/><Button x:Name="QuickManual" Content="♧    Manual Connect"/></StackPanel></Border>
  </StackPanel></ScrollViewer></Border>
 </Grid>
</Window>

